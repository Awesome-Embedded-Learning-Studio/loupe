{
  "name": "@aels/loupe-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue component layer for loupe: terminal and machine controls, embeddable in VitePress.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "vite build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^18.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.6",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "@aels/wasm-runtime-host": "workspace:*"
  }
}
